{
    "layer": "top",
    "position": "bottom",
    "height": 22,
    "spacing": 0,

    "modules-left": [
        "niri/workspaces",
        "custom/layout",
        "niri/window"
    ],
    "modules-center": [],
    "modules-right": [
        "clock"
    ],

    "niri/workspaces": {
        "format": "{value}",
        "on-click": "activate"
    },

    "custom/layout": {
        "format": "$",
        "tooltip": false
    },

    "niri/window": {
        "format": "~",
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    }
}
